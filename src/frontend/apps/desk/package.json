    "eslint-plugin-vitest": "^0.5.4",
    "i18next": "27.1.2",
    "i18next-browser-languagedetector": "8.3.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "react": "*",
    "react-dom": "*",
